# Google Sheets (from your service account JSON key file)
GOOGLE_SERVICE_ACCOUNT_EMAIL=app-backend@tutoring-platform-xxxxx.iam.gserviceaccount.com
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYOUR_KEY_HERE\n-----END PRIVATE KEY-----\n"
GOOGLE_SHEET_ID=your_sheet_id_from_url

# JWT secret — run: openssl rand -hex 32
JWT_SECRET=replace_with_output_of_openssl_rand_hex_32

# Public URL (change to your Vercel URL in production)
NEXT_PUBLIC_APP_URL=http://localhost:3000
